# Copy to .env on the machine that runs testnet mode. .env is git-ignored —
# never commit it, never paste these values anywhere else.
#
# Create the key at https://testnet.bybit.com -> API Management:
#   - "System-generated API keys", permissions: Contract -> Orders + Positions
#     (Unified Trading). NO withdrawal / transfer permissions.
#   - Restrict it to this machine's IP address.

TRADEBOT_MODE=testnet
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Set to 1 to stop opening new positions (open ones keep their exchange stops/targets).
TRADEBOT_HALT=0
