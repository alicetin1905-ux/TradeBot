# Copy to .env on the machine that runs the bot against Bybit. .env is
# git-ignored — never commit it, never paste these values anywhere else.
#
# TRADEBOT_MODE=demo     Bybit Demo Trading (api-demo.bybit.com): mainnet prices,
#                        demo funds. Key: log in at bybit.com, switch to
#                        "Demo Trading", then API Management -> Create New Key.
#
# Either way: system-generated key, Read-Write, permissions Contract ->
# Orders + Positions (Unified Trading) only. NO withdrawal/transfer.
# Restrict it to this machine's IP. A demo key only works for demo.

TRADEBOT_MODE=demo
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Set to 1 to stop opening new positions (open ones keep their exchange stops/targets).
TRADEBOT_HALT=0
